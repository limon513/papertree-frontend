---
import Layout from '@/layouts/Layout.astro';
import AccountView from '@/components/islands/AccountView';

// The page is the same for everyone; who is signed in is asked by the browser.
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');
---

<Layout title="Your account" noindex>
  <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 sm:py-8">
    <h1 class="font-display text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl">Your account</h1>
    <AccountView client:load />
  </div>
</Layout>
