---
import Layout from '@/layouts/Layout.astro';
import QuoteRequest from '@/components/islands/QuoteRequest';

/** Make a quotation from the cart (the cart lives in the browser, so the page is the same for everyone). */
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');
---

<Layout title="Get a quotation" noindex>
  <div class="mx-auto max-w-5xl px-4 py-5 sm:px-6 sm:py-8">
    <a href="/cart/" class="text-sm font-medium text-brand-700 hover:underline">← Back to cart</a>
    <h1 class="mt-2 font-display text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl">Get a quotation</h1>
    <p class="mt-1 max-w-2xl text-zinc-600">For schools, offices and shops: your cart as a priced list with a number, to print, share or order later at these prices.</p>
    <QuoteRequest client:load />
  </div>
</Layout>
