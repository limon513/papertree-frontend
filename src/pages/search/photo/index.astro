---
import Layout from '@/layouts/Layout.astro';
import PhotoResults from '@/components/islands/PhotoResults';
import { getCatalog } from '@/lib/api';

/**
 * Search by photo: the results for the photo the shopper just took or chose (kept in their browser
 * for this tab), or ?like=ID: products that look like that one. Not for Google.
 */
const like = Number(Astro.url.searchParams.get('like'));
const likeId = Number.isInteger(like) && like > 0 ? like : null;
const { store } = await getCatalog();
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');
---

<Layout title={likeId ? 'Similar items' : 'Search by photo'} description="Find products with a photo." noindex>
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <PhotoResults client:load likeId={likeId} whatsapp={store.whatsapp ?? null} />
  </div>
</Layout>
