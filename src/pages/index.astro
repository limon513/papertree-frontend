---
import { ArrowRight, Building2, ChevronLeft, ChevronRight, Flame, Sparkles, Truck } from 'lucide-preact';
import Layout from '@/layouts/Layout.astro';
import ProductRail from '@/components/ProductRail.astro';
import HeroBanners from '@/components/HeroBanners.astro';
import { getCatalog, getHome } from '@/lib/api';
import { iconUrl, imageAt, links, SITE_URL, srcSet } from '@/lib/utils';

const [home, catalog] = await Promise.all([getHome(), getCatalog()]);
const { store, categories, brands } = catalog;
// A few real product pictures for the banner (computers).
// Banners from the admin, when there is at least one for the slider.
const banners = home.banners?.hero.length ? home.banners : null;
const showcase = [...home.deals, ...home.newArrivals].filter((p) => p.image).slice(0, 4);
const whatsapp = store.whatsapp ? `https://wa.me/88${store.whatsapp}?text=${encodeURIComponent('Hello PaperTree, I want to buy wholesale.')}` : null;

// Google: who the shop is, and that the site has its own search.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Store',
    name: `${store.name} Bangladesh`,
    url: `${SITE_URL}/`,
    ...(store.logo && { logo: imageAt(store.logo, 400), image: imageAt(store.logo, 400) }),
    ...(store.phone && { telephone: store.phone }),
    ...(store.email && { email: store.email }),
    ...(store.address && { address: { '@type': 'PostalAddress', streetAddress: store.address, addressCountry: 'BD' } }),
    sameAs: Object.values(store.social).filter(Boolean),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${store.name} Bangladesh`,
    url: `${SITE_URL}/`,
    potentialAction: { '@type': 'SearchAction', target: `${SITE_URL}/search/?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
  },
];

// The CDN may keep the page for a minute; prices and stock stay fresh enough.
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
---

<Layout title={`${store.name} Bangladesh | Stationery, Paper & Art Supplies`} fullTitle canonical="/" jsonLd={jsonLd}>
  <!-- Banners from the admin; without any, a simple welcome banner (short on phones, so products show on the first screen). -->
  {
    banners ? (
      <>
        <h1 class="sr-only">{store.name} Bangladesh: paper, pens and art supplies</h1>
        <HeroBanners hero={banners.hero} tiles={banners.tiles} />
      </>
    ) : (
  <section class="bg-paper">
    <div class="mx-auto grid max-w-site items-center gap-6 px-4 py-5 sm:px-6 sm:py-8 md:grid-cols-[1.1fr_1fr] md:py-10">
      <div>
        <p class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-800">
          <Truck class="size-3.5" /> Delivery all over Bangladesh
        </p>
        <h1 class="mt-3 font-display text-[1.7rem] leading-[1.1] font-bold tracking-tight text-zinc-900 sm:text-5xl">
          Paper, pens & art supplies.
          <span class="block text-brand-700">All in one basket.</span>
        </h1>
        <p class="mt-3 hidden max-w-md text-[15px] text-zinc-600 sm:block">Add what you need with one tap — school, office or studio. Pay cash when it arrives.</p>
        <div class="mt-4 flex flex-wrap gap-2 sm:mt-5">
          <a href="/deals/" class="flex h-10 items-center gap-2 rounded-xl bg-brand-700 px-4 text-sm font-semibold text-white hover:bg-brand-800 sm:h-11 sm:px-5">
            Today’s deals <ArrowRight class="size-4" />
          </a>
          <a href="/categories/" class="flex h-10 items-center rounded-xl bg-white px-4 text-sm font-semibold text-zinc-800 ring-1 ring-zinc-300 hover:ring-zinc-400 sm:h-11 sm:px-5">
            Browse categories
          </a>
        </div>
      </div>
      {
        showcase.length >= 3 && (
          <div class="hidden grid-cols-2 gap-3 md:grid">
            {showcase.map((p, i) => (
              <a
                href={links.product(p.slug)}
                class:list={['flex aspect-[4/3] items-center justify-center rounded-3xl bg-white p-4 shadow-sm ring-1 ring-zinc-200/70 transition hover:-translate-y-0.5', i % 2 && 'translate-y-4']}
              >
                <img
                  src={imageAt(p.image!, 400)}
                  srcset={srcSet(p.image!)}
                  sizes="240px"
                  width={p.image!.width}
                  height={p.image!.height}
                  alt={p.name}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="max-h-full w-auto object-contain"
                />
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
    )
  }

  <!-- Category shelf: one row; swipe on phones, arrow buttons on computers. -->
  <section class="mx-auto max-w-site px-4 pt-6 sm:px-6" aria-label="Categories">
    <div class="rail relative">
      <ul class="scrollbar-none -mx-4 flex snap-x gap-2.5 overflow-x-auto scroll-px-4 px-4 py-1.5 sm:-mx-6 sm:gap-3 sm:scroll-px-6 sm:px-6 lg:-mx-1 lg:scroll-px-1 lg:px-1">
        {
          categories.map((c) => (
            <li class="w-24 shrink-0 snap-start sm:w-32 lg:w-[calc((100%-8*0.75rem)/9)]">
              <a
                href={links.category([c.slug])}
                class="flex h-full flex-col items-center gap-2 rounded-2xl bg-white p-3 text-center ring-1 ring-zinc-200 transition hover:-translate-y-0.5 hover:shadow-md hover:shadow-zinc-900/5 hover:ring-brand-300"
              >
                <span class="flex size-14 items-center justify-center rounded-xl bg-brand-50">
                  {c.icon ? <img src={iconUrl(c.icon)} alt="" width="36" height="36" class="size-9" /> : <Sparkles class="size-6 text-brand-600" />}
                </span>
                <span class="text-xs leading-tight font-medium text-zinc-800 sm:text-sm">{c.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <button type="button" data-dir="-1" aria-label="Previous categories" class="rail-arrow absolute top-1/2 -left-4 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-zinc-700 opacity-0 shadow-md ring-1 ring-zinc-200 transition hover:text-brand-700 lg:flex">
        <ChevronLeft class="size-5" />
      </button>
      <button type="button" data-dir="1" aria-label="More categories" class="rail-arrow absolute top-1/2 -right-4 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-zinc-700 opacity-0 shadow-md ring-1 ring-zinc-200 transition hover:text-brand-700 lg:flex">
        <ChevronRight class="size-5" />
      </button>
    </div>
  </section>

  <ProductRail title="Today’s deals" href="/deals/" products={home.deals} tone="deals" priority>
    <Flame slot="icon" class="size-6 text-marigold-500" />
  </ProductRail>
  {home.bestSellers.length >= 4 && <ProductRail title="Best sellers" href="/shop/?sort=popular" products={home.bestSellers} />}
  <ProductRail title="New arrivals" href="/new/" products={home.newArrivals} />
  {
    home.categoryRows.map((row) => (
      <ProductRail title={row.category.name} href={links.category([row.category.slug])} products={row.products}>
        {row.category.icon && <img slot="icon" src={iconUrl(row.category.icon)} alt="" width="28" height="28" loading="lazy" class="size-7" />}
      </ProductRail>
    ))
  }

  {
    brands.length > 0 && (
      <section class="later mx-auto max-w-site px-4 py-8 sm:px-6">
        <div class="mb-4 flex items-end justify-between">
          <h2 class="font-display text-xl font-bold tracking-tight sm:text-2xl">Shop by brand</h2>
          <a href="/brands/" class="flex items-center gap-1 text-sm font-semibold text-brand-700">
            All brands <ArrowRight class="size-4" />
          </a>
        </div>
        <ul class="grid grid-cols-3 gap-2 sm:grid-cols-5 sm:gap-3 lg:grid-cols-10">
          {brands.map((b) => (
            <li>
              <a href={links.brand(b.slug)} class="flex h-20 flex-col items-center justify-center gap-1 rounded-2xl bg-white p-2 text-center ring-1 ring-zinc-200/80 transition hover:ring-brand-300">
                {b.image ? (
                  <img src={imageAt(b.image, 160)} srcset={srcSet(b.image)} sizes="120px" width={b.image.width} height={b.image.height} alt={b.name} loading="lazy" class="h-9 w-auto object-contain" />
                ) : b.icon ? (
                  <img src={iconUrl(b.icon)} alt="" width="32" height="32" loading="lazy" class="size-8" />
                ) : null}
                <span class="text-xs font-semibold text-zinc-800">{b.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Wholesale: the business sign-up on the account page (or a question on WhatsApp). -->
  <section class="mx-auto max-w-site px-4 sm:px-6">
    <div class="flex flex-col items-start gap-4 rounded-3xl bg-brand-800 p-6 text-white sm:flex-row sm:items-center sm:p-8">
      <Building2 class="size-10 shrink-0 text-brand-300" />
      <div class="flex-1">
        <h2 class="font-display text-xl font-bold sm:text-2xl">Buying for a shop, school or office?</h2>
        <p class="mt-1 text-sm text-brand-100">Wholesale prices, a small advance and the rest cash on delivery.</p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-2">
        <a href="/wholesale/" class="flex h-11 items-center rounded-xl bg-white px-5 text-sm font-semibold text-brand-800 hover:bg-brand-50">
          See how wholesale works
        </a>
        {
          whatsapp && (
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="flex h-11 items-center rounded-full px-5 text-sm font-semibold text-white ring-1 ring-white/40 hover:bg-white/10">
              WhatsApp us
            </a>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  import '@/scripts/rails';
</script>
