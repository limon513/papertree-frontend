---
import Layout from '@/layouts/Layout.astro';
import { getCatalog } from '@/lib/api';
import { iconUrl, imageAt, links, srcSet } from '@/lib/utils';

const { brands } = await getCatalog();
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');
---

<Layout title="All brands" description="DOMS, Pilot, Faber-Castell, Matador and more original brands, with cash on delivery across Bangladesh.">
  <div class="mx-auto max-w-site px-4 py-6 sm:px-6 sm:py-8">
    <h1 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">All brands</h1>
    <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      {
        brands.map((b) => (
          <li>
            <a href={links.brand(b.slug)} class="flex h-32 flex-col items-center justify-center gap-2 rounded-3xl bg-white p-4 text-center ring-1 ring-zinc-200/80 transition hover:-translate-y-0.5 hover:ring-brand-300">
              {b.image ? (
                <img src={imageAt(b.image, 160)} srcset={srcSet(b.image)} sizes="160px" width={b.image.width} height={b.image.height} alt={b.name} loading="lazy" class="h-12 w-auto object-contain" />
              ) : b.icon ? (
                <img src={iconUrl(b.icon)} alt="" width="40" height="40" class="size-10" />
              ) : null}
              <span class="font-semibold text-zinc-800">{b.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
