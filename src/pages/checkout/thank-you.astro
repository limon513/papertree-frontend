---
import { Banknote, CheckCircle2, MessageCircle, Phone, Truck, XCircle } from 'lucide-preact';
import Layout from '@/layouts/Layout.astro';
import { ParcelCard } from '@/components/islands/TrackOrder';
import { getCatalog, getOrder, NotFound } from '@/lib/api';
import type { PlacedOrder } from '@/lib/types';
import { imageAt, money } from '@/lib/utils';

/** After placing an order. The link carries the order's secret token: no sign-in needed. */
const token = (Astro.url.searchParams.get('o') ?? '').slice(0, 60);
let order: PlacedOrder | null = null;
try {
  if (token) order = await getOrder(token);
} catch (err) {
  if (!(err instanceof NotFound)) throw err;
}
const { store } = await getCatalog();
// Personal: never kept by the browser cache or the CDN.
Astro.response.headers.set('cache-control', 'private, no-store');
if (!order) Astro.response.status = 404;
const firstName = order?.customerName.split(' ')[0];
/** After staff move the order on, the page says where it is (the update emails link here). */
const STATE: Record<string, string> = { confirmed: 'is confirmed', packed: 'is confirmed', shipped: 'is on the way', delivered: 'is delivered', cancelled: 'is cancelled', returned: 'was returned' };
const moved = order && order.status !== 'pending' ? (STATE[order.status] ?? null) : null;
const place = order ? [order.address, order.areaName, order.districtName].filter(Boolean).join(', ') : '';
const cents = (n: number) => Math.round(n * 100) / 100;
/** Still to pay, all of it (cash on delivery) unless some was paid already. */
const due = order ? Math.max(0, cents(order.total - (order.paidAmount ?? 0))) : 0;
const wholesale = order?.type === 'wholesale';
/** A wholesale advance not paid yet: how much, and what is left for delivery. */
const advance = order && wholesale && (order.advanceRequired ?? 0) > (order.paidAmount ?? 0) ? cents((order.advanceRequired ?? 0) - (order.paidAmount ?? 0)) : null;
const payLine = due <= 0 ? 'It is fully paid.' : null;
const whatsapp = order && store.whatsapp ? `https://wa.me/88${store.whatsapp}?text=${encodeURIComponent(`Hello PaperTree, about my order #${order.number}`)}` : null;
---

<Layout title={order ? `Order #${order.number} ${moved ?? 'placed'}` : 'Order not found'} noindex>
  <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 sm:py-12">
    {
      !order ? (
        <div class="text-center">
          <h1 class="font-display text-2xl font-bold">We couldn’t find that order</h1>
          <p class="mt-2 text-zinc-600">The link may be incomplete. If you placed an order, we will call you to confirm it.</p>
          {store.phone && <p class="mt-4"><a href={`tel:${store.phone}`} class="font-semibold text-brand-700">Call {store.phone}</a></p>}
        </div>
      ) : (
        <>
          {moved ? (
            <div class="text-center">
              {order.status === 'shipped' ? <Truck class="mx-auto size-14 text-brand-600" /> : order.status === 'cancelled' || order.status === 'returned' ? <XCircle class="mx-auto size-14 text-zinc-400" /> : <CheckCircle2 class="mx-auto size-14 text-brand-600" />}
              <h1 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-3xl">Your order #{order.number} {moved}</h1>
              {(order.status === 'confirmed' || order.status === 'packed') && (
                <p class="mt-2 text-zinc-700">
                  We are getting it ready and will send it to <strong>{place}</strong>{order.deliveryTime && <>, usually in <strong>{order.deliveryTime}</strong></>}. {payLine ?? <>Pay <strong>{money(due)}</strong> in cash when it arrives.</>}
                </p>
              )}
              {order.status === 'shipped' && (
                <>
                  <p class="mt-2 text-zinc-700">
                    It is on the way to <strong>{place}</strong>{order.courier && <> with <strong>{order.courier}</strong></>}. {payLine ?? <>Pay <strong>{money(due)}</strong> in cash when it arrives.</>}
                  </p>
                </>
              )}
              {order.status === 'delivered' && <p class="mt-2 text-zinc-700">Thank you for shopping with us, {firstName}! If anything is wrong, tell us and we will make it right.</p>}
              {(order.status === 'cancelled' || order.status === 'returned') && <p class="mt-2 text-zinc-700">If this is a mistake, call or WhatsApp us and we will sort it out.</p>}
            </div>
          ) : (
            <>
            <div class="text-center">
              <CheckCircle2 class="mx-auto size-14 text-brand-600" />
              <h1 class="mt-3 font-display text-2xl font-bold tracking-tight sm:text-3xl">Thank you, {firstName}!</h1>
              <p class="mt-1 text-lg text-zinc-700">
                Your {wholesale ? 'wholesale order' : 'order'} <strong class="text-zinc-900">#{order.number}</strong> is placed.
              </p>
            </div>

            <ol class="mt-8 space-y-4 rounded-2xl bg-brand-50 p-5 text-sm text-brand-950">
              {advance !== null && (
                <li class="flex gap-3">
                  <Banknote class="mt-0.5 size-5 shrink-0 text-brand-700" />
                  <span>
                    Pay the advance of <strong>{money(advance)}</strong>
                    {order.payAdvance ? <>: <span class="whitespace-pre-line">{order.payAdvance}</span></> : ' (we call you with the details)'}. Write <strong>#{order.number}</strong> as the reference.
                  </span>
                </li>
              )}
              <li class="flex gap-3">
                <Phone class="mt-0.5 size-5 shrink-0 text-brand-700" />
                <span>We will call you on <strong>{order.phone}</strong> soon to confirm.</span>
              </li>
              <li class="flex gap-3">
                <Truck class="mt-0.5 size-5 shrink-0 text-brand-700" />
                <span>
                  {advance !== null ? 'Once the advance arrives, we send it' : 'Then we send it'} to <strong>{place}</strong>{order.deliveryTime && <>, usually in <strong>{order.deliveryTime}</strong></>}.
                </span>
              </li>
              <li class="flex gap-3">
                <CheckCircle2 class="mt-0.5 size-5 shrink-0 text-brand-700" />
                <span>{payLine ?? <>Pay {advance !== null ? 'the rest, ' : ''}<strong>{money(advance !== null ? cents(due - advance) : due)}</strong>, in cash when it arrives.</>}</span>
              </li>
            </ol>
            </>
          )}

          {(order.status === 'shipped' || order.status === 'delivered') && (order.courier || order.trackingCode || order.journey?.length) ? (
            <div class="mt-6 text-left">
              <ParcelCard order={{ courier: order.courier ?? null, trackingCode: order.trackingCode ?? null, trackingUrl: order.trackingUrl ?? null, parcelStatus: order.parcelStatus ?? null, journey: order.journey ?? [] }} />
            </div>
          ) : null}

          <section class="mt-8 rounded-2xl ring-1 ring-zinc-200">
            <h2 class="border-b border-zinc-100 px-5 py-3 font-display text-lg font-bold">Order #{order.number}</h2>
            <ul class="divide-y divide-zinc-100 px-5">
              {order.items.map((i) => (
                <li class="flex items-center gap-3 py-3">
                  <span class="size-12 shrink-0 rounded-lg bg-zinc-50">{i.image && <img src={imageAt(i.image, 160)} alt="" width="48" height="48" class="size-full object-contain p-1" />}</span>
                  <span class="min-w-0 flex-1 text-sm">
                    <span class="block text-zinc-900">{i.name}</span>
                    <span class="text-zinc-500">
                      {i.variantLabel && <>{i.variantLabel} · </>}
                      {i.quantity} × {money(i.unitPrice)}
                      {i.bulkPercent ? <span class="text-brand-700"> · {i.bulkPercent}% bulk discount</span> : null}
                    </span>
                  </span>
                  <span class="text-sm font-medium tabular-nums">{money(i.lineTotal)}</span>
                </li>
              ))}
            </ul>
            <dl class="space-y-1.5 border-t border-zinc-100 px-5 py-4 text-sm">
              <div class="flex justify-between"><dt class="text-zinc-600">Items</dt><dd class="tabular-nums">{money(order.subtotal)}</dd></div>
              {order.bulkDiscount ? <p class="text-right text-xs text-brand-700">You saved {money(order.bulkDiscount)} with bulk discounts</p> : null}
              <div class="flex justify-between"><dt class="text-zinc-600">Delivery</dt><dd class="tabular-nums">{order.deliveryFee === 0 ? 'Free' : money(order.deliveryFee)}</dd></div>
              {order.couponDiscount ? <div class="flex justify-between text-brand-700"><dt>Coupon <span class="font-mono">{order.couponCode}</span></dt><dd class="tabular-nums">−{money(order.couponDiscount)}</dd></div> : null}
              <div class="flex justify-between pt-1.5 text-base font-bold"><dt>Total{order.paymentMethod === 'cod' && !wholesale ? ' (cash on delivery)' : ''}</dt><dd class="tabular-nums">{money(order.total)}</dd></div>
              {(order.paidAmount ?? 0) > 0 && <div class="flex justify-between text-brand-700"><dt>Paid</dt><dd class="tabular-nums">{money(order.paidAmount ?? 0)}</dd></div>}
              {advance !== null && <div class="flex justify-between text-brand-800"><dt>Advance to pay now</dt><dd class="font-semibold tabular-nums">{money(advance)}</dd></div>}
            </dl>
          </section>

          <div class="mt-8 flex flex-wrap justify-center gap-2">
            <a href="/" class="flex h-11 items-center rounded-xl bg-brand-700 px-5 text-sm font-semibold text-white hover:bg-brand-800">Continue shopping</a>
            {whatsapp && (
              <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="flex h-11 items-center gap-2 rounded-xl px-5 text-sm font-semibold text-brand-700 ring-1 ring-brand-200 hover:bg-brand-50">
                <MessageCircle class="size-4" /> Questions? WhatsApp us
              </a>
            )}
          </div>
          <p class="mt-4 text-center text-xs text-zinc-500">Keep this page’s link to see your order again.</p>
        </>
      )
    }
  </div>
</Layout>
