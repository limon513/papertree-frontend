---
import { BadgeCheck, Building2, ChevronRight, Sparkles, Tag } from 'lucide-preact';
import Layout from '@/layouts/Layout.astro';
import { getCatalog } from '@/lib/api';
import { iconUrl, links } from '@/lib/utils';

const { categories } = await getCatalog();
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');
---

<Layout title="All categories" description="Paper, notebooks, pens, art and craft, office and school supplies: every category at PaperTree.">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8">
    <h1 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">All categories</h1>
    <!-- Quick links (on phones the top menu is hidden, so these live here too). -->
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="More ways to shop">
      {
        [
          { href: '/deals/', label: 'Deals', Icon: Tag, tone: 'bg-marigold-100 text-zinc-900 hover:bg-marigold-200' },
          { href: '/new/', label: 'New arrivals', Icon: Sparkles, tone: 'bg-zinc-100 text-zinc-800 hover:bg-zinc-200' },
          { href: '/brands/', label: 'Brands', Icon: BadgeCheck, tone: 'bg-zinc-100 text-zinc-800 hover:bg-zinc-200' },
          { href: '/wholesale/', label: 'Wholesale for businesses', Icon: Building2, tone: 'bg-brand-50 text-brand-800 hover:bg-brand-100' },
        ].map(({ href, label, Icon, tone }) => (
          <li>
            <a href={href} class:list={['flex h-10 items-center gap-1.5 rounded-full px-4 text-sm font-semibold', tone]}>
              <Icon class="size-4" /> {label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((c) => (
          <li class="rounded-3xl bg-white p-4 ring-1 ring-zinc-200/80">
            <a href={links.category([c.slug])} class="flex items-center gap-3">
              <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-brand-50">
                {c.icon ? <img src={iconUrl(c.icon)} alt="" width="36" height="36" class="size-9" /> : <Sparkles class="size-6 text-brand-600" />}
              </span>
              <span class="flex-1">
                <span class="block font-display text-lg font-bold text-zinc-900">{c.name}</span>
                <span class="text-sm text-zinc-500">{c.productCount} products</span>
              </span>
              <ChevronRight class="size-5 text-zinc-400" />
            </a>
            {c.children.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {c.children.map((child) => (
                  <li>
                    <a href={links.category([c.slug, child.slug])} class="block rounded-full bg-zinc-100 px-3 py-1.5 text-sm text-zinc-700 hover:bg-brand-50 hover:text-brand-800">
                      {child.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
