---
import { Hammer } from 'lucide-preact';
import CustomStudio from '@/components/islands/CustomStudio';
import Layout from '@/layouts/Layout.astro';
import { getCatalog } from '@/lib/api';

/**
 * Custom Order Studio: notebooks, canvas, printed pens, paper, stickers and more, made to order.
 * The customer describes it; staff call back with a priced quotation they can order online.
 */
const { store } = await getCatalog();
const whatsapp = store.whatsapp
  ? `https://wa.me/88${store.whatsapp.replace(/\D/g, '').replace(/^88/, '')}?text=${encodeURIComponent(`Hello ${store.name}, I want something custom made.`)}`
  : null;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');
---

<Layout
  title="Custom orders: notebooks, pens, canvas and more"
  description={`Made to order by ${store.name}: custom notebooks, branded pens, printed paper and card, canvas, stickers and folders for schools, offices and events. Tell us what you need and get a price.`}
  canonical="/custom-order/"
>
  <section class="bg-linear-to-br from-brand-800 via-brand-700 to-lime-600 text-white">
    <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
      <p class="flex items-center gap-2 text-sm font-semibold tracking-wide text-brand-200 uppercase"><Hammer class="size-4" /> Made to order</p>
      <h1 class="mt-2 max-w-2xl font-display text-3xl font-bold tracking-tight sm:text-4xl">Custom Order Studio</h1>
      <p class="mt-3 max-w-2xl text-brand-100">
        Notebooks with your school's logo, branded pens, printed paper and card, canvas, stickers and folders. Tell us what you need in a few steps; we call you and send a price.
      </p>
    </div>
  </section>
  <div class="mx-auto max-w-5xl px-4 pb-12 sm:px-6">
    <CustomStudio client:load whatsapp={whatsapp} />
  </div>
</Layout>
