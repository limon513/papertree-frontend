---
import { Phone } from 'lucide-preact';
import TrackOrder from '@/components/islands/TrackOrder';
import Layout from '@/layouts/Layout.astro';
import { getCatalog } from '@/lib/api';

/** Track an order with its number and phone. The answer comes from the shop in the browser. */
const { store } = await getCatalog();
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');
---

<Layout title="Track your order" description="See where your order is: enter the order number and the phone number you ordered with." canonical="/track-order/">
  <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 sm:py-12">
    <h1 class="font-display text-3xl font-bold tracking-tight text-zinc-900">Track your order</h1>
    <p class="mt-2 text-zinc-600">Enter your order number and the phone number you ordered with.</p>
    <div class="mt-6">
      <TrackOrder client:load />
    </div>
    {
      store.phone && (
        <p class="mt-8 flex items-center gap-2 text-sm text-zinc-600">
          <Phone class="size-4 text-brand-700" /> Need help? Call <a href={`tel:${store.phone}`} class="font-semibold text-brand-700">{store.phone}</a>
        </p>
      )
    }
  </div>
</Layout>
