---
import { ChevronRight, LayoutGrid } from 'lucide-preact';
import type { CategoryNode } from '@/lib/types';
import { iconUrl, links } from '@/lib/utils';

/**
 * "All categories" on computers: main categories on the left, the pointed one's sub-categories on the right.
 * Plain CSS (hover and keyboard focus), no JavaScript. Until one is pointed at, the first is shown.
 */
interface Props {
  categories: CategoryNode[];
}
const { categories } = Astro.props;
---

<div class="group/menu relative">
  <button
    type="button"
    aria-haspopup="true"
    class="flex h-10 items-center gap-2 rounded-full bg-brand-50 px-4 text-sm font-semibold text-brand-800 transition-colors group-focus-within/menu:bg-brand-700 group-focus-within/menu:text-white group-hover/menu:bg-brand-700 group-hover/menu:text-white"
  >
    <LayoutGrid class="size-4" /> All categories
  </button>
  <!-- pt-2 is a bridge: the pointer can travel from the button to the menu without closing it. -->
  <div
    class="invisible absolute top-full left-0 z-50 pt-2 opacity-0 transition-[opacity,visibility] delay-100 duration-150 group-focus-within/menu:visible group-focus-within/menu:opacity-100 group-focus-within/menu:delay-0 group-hover/menu:visible group-hover/menu:opacity-100 group-hover/menu:delay-0"
  >
    <div class="cat-menu relative w-[720px] overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-zinc-200">
      <ul class="w-64 border-r border-zinc-100 bg-zinc-50/60 py-2">
        {
          categories.map((c, i) => (
            <li class="cat group/cat">
              <a
                href={links.category([c.slug])}
                class:list={[
                  'flex items-center gap-2.5 px-4 py-2 text-sm text-zinc-700 group-focus-within/cat:bg-white group-focus-within/cat:font-medium group-focus-within/cat:text-brand-800 group-hover/cat:bg-white group-hover/cat:font-medium group-hover/cat:text-brand-800',
                  i === 0 && 'in-[.cat-menu:not(:has(.cat:hover,.cat:focus-within))]:bg-white in-[.cat-menu:not(:has(.cat:hover,.cat:focus-within))]:font-medium',
                ]}
              >
                {c.icon ? <img src={iconUrl(c.icon)} alt="" width="24" height="24" loading="lazy" class="size-6" /> : <span class="size-6" />}
                <span class="flex-1">{c.name}</span>
                <ChevronRight class="size-4 text-zinc-300" />
              </a>
              <div
                class:list={[
                  'absolute inset-y-0 right-0 left-64 hidden overflow-y-auto p-5 group-focus-within/cat:block group-hover/cat:block',
                  i === 0 && 'in-[.cat-menu:not(:has(.cat:hover,.cat:focus-within))]:block',
                ]}
              >
                <a href={links.category([c.slug])} class="font-display text-lg font-bold text-zinc-900 hover:text-brand-700">
                  {c.name}
                </a>
                <p class="text-sm text-zinc-500">{c.productCount} products</p>
                {c.children.length > 0 && (
                  <ul class="mt-4 grid grid-cols-2 gap-2">
                    {c.children.map((child) => (
                      <li>
                        <a href={links.category([c.slug, child.slug])} class="flex items-center gap-2.5 rounded-xl p-2 hover:bg-brand-50">
                          {child.icon ? (
                            <img src={iconUrl(child.icon)} alt="" width="32" height="32" loading="lazy" class="size-8" />
                          ) : (
                            <span class="size-8 rounded-lg bg-zinc-100" />
                          )}
                          <span class="text-sm text-zinc-800">
                            {child.name}
                            <span class="block text-xs text-zinc-500">{child.productCount} products</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                <a href={links.category([c.slug])} class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">
                  See all {c.name} →
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>
