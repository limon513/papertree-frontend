---
import { Clock, Mail, MapPin, Phone } from 'lucide-preact';
import type { Catalog } from '@/lib/types';
import { imageAt } from '@/lib/utils';

/**
 * Site footer: the client's minimal footer (2026-11-20), in the soft lime of the New arrivals band.
 * - Left: the logo, contact details, then round Facebook, WhatsApp and phone buttons.
 * - Right: the information pages written in the admin (Pages marked "show in footer", in their order),
 *   "Sell with us",
 *   then Blog and Affiliate marketing, both coming soon.
 * Under it the SSLCommerz "Pay with" strip and the copyright line.
 */
interface Props {
  catalog: Catalog;
}
const { store, pages } = Astro.props.catalog;
const whatsapp = store.whatsapp ? `https://wa.me/88${store.whatsapp.replace(/\D/g, '').replace(/^88/, '')}` : null;
const facebook = store.social.facebook;
const SOON = ['Blog', 'Affiliate marketing'];
const round = 'flex size-11 items-center justify-center rounded-full bg-brand-600 text-white transition-colors hover:bg-brand-700';
---

<footer class="mt-12 border-t border-lime-200 bg-lime-50 text-sm text-zinc-800">
  <div class="mx-auto grid max-w-site gap-x-12 gap-y-9 px-4 pt-10 pb-9 sm:px-6 md:grid-cols-[minmax(0,1fr)_auto] lg:pt-12">
    <!-- The shop: logo, contact, buttons -->
    <div>
      <a href="/" aria-label={`${store.name} home`} class="inline-flex rounded-2xl bg-white p-2 shadow-sm ring-1 ring-zinc-900/5">
        {
          store.logo ? (
            <img src={imageAt(store.logo, 275)} alt="" width={store.logo.width} height={store.logo.height} loading="lazy" class="h-16 w-auto sm:h-20" />
          ) : (
            <span class="px-2 py-1 font-display text-xl font-bold">{store.name}</span>
          )
        }
      </a>
      <ul class="mt-5 space-y-2.5">
        {
          store.phone && (
            <li class="flex gap-2.5">
              <Phone class="mt-0.5 size-4 shrink-0" />
              <a href={`tel:${store.phone}`} class="font-semibold hover:underline">{store.phone}</a>
            </li>
          )
        }
        {
          store.email && (
            <li class="flex gap-2.5">
              <Mail class="mt-0.5 size-4 shrink-0" />
              <a href={`mailto:${store.email}`} class="break-all hover:underline">{store.email}</a>
            </li>
          )
        }
        {
          store.address && (
            <li class="flex gap-2.5">
              <MapPin class="mt-0.5 size-4 shrink-0" />
              <span class="leading-relaxed">{store.address}</span>
            </li>
          )
        }
        {
          store.openingHours && (
            <li class="flex gap-2.5">
              <Clock class="mt-0.5 size-4 shrink-0" />
              {store.openingHours}
            </li>
          )
        }
      </ul>
      {
        (facebook || whatsapp || store.phone) && (
          <ul class="mt-5 flex gap-2.5" aria-label="Reach us">
            {facebook && (
              <li>
                <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook" class={round}>
                  <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
                    <path d="M9.1 23.7v-8H6.6V12h2.5v-1.6c0-4.1 1.8-6 5.9-6 .8 0 2.1.2 2.6.3v3.4h-1.4c-1.9 0-2.6.7-2.6 2.6V12h3.9l-.7 3.7h-3.2V24C19.4 23.2 24 18.2 24 12 24 5.4 18.6 0 12 0S0 5.4 0 12c0 5.6 3.9 10.4 9.1 11.7Z" />
                  </svg>
                </a>
              </li>
            )}
            {whatsapp && (
              <li>
                <a href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" title="WhatsApp" class={round}>
                  <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
                    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.59-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.42.25-.69.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35M12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.22-3.74.99 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 7c0 5.44-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45h.01c6.55 0 11.89-5.34 11.89-11.9a11.82 11.82 0 0 0-3.48-8.4Z" />
                  </svg>
                </a>
              </li>
            )}
            {store.phone && (
              <li>
                <a href={`tel:${store.phone}`} aria-label={`Call ${store.phone}`} title="Call us" class={round}>
                  <Phone class="size-5" />
                </a>
              </li>
            )}
          </ul>
        )
      }
    </div>

    <!-- Information pages -->
    <nav aria-labelledby="footer-info">
      <h2 id="footer-info" class="text-xs font-bold tracking-[0.15em] text-brand-800 uppercase">Information</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 md:gap-x-16 lg:pr-8">
        {
          (pages ?? []).map((p) => (
            <li>
              <a href={`/${p.slug}/`} class="font-medium decoration-2 underline-offset-4 hover:underline">
                {p.title}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/sell-with-us/" class="font-medium decoration-2 underline-offset-4 hover:underline">Sell with us</a>
        </li>
        {
          SOON.map((name) => (
            <li class="flex flex-wrap items-center gap-x-2 gap-y-1 text-zinc-500">
              {name}
              <span class="rounded-full bg-lime-200/70 px-2 py-0.5 text-[11px] font-semibold text-lime-900">Coming soon</span>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Payment methods (SSLCommerz's "Pay with" strip). On phones it slides sideways, so the logos stay readable. -->
  <div class="bg-white">
    <div class="scrollbar-none mx-auto max-w-site overflow-x-auto px-4 py-2.5 sm:px-6">
      <a href="https://www.sslcommerz.com/" target="_blank" rel="noopener noreferrer" title="SSLCommerz" class="block min-w-[1100px]">
        <img
          src="/payments/sslcommerz-pay-with.webp"
          alt="Pay with cards, mobile banking and internet banking. Verified by SSLCommerz"
          width="3200"
          height="105"
          loading="lazy"
          decoding="async"
          class="h-auto w-full"
        />
      </a>
    </div>
  </div>

  <div class="border-t border-lime-200 bg-lime-100">
    <p class="mx-auto max-w-site px-4 py-3.5 text-xs font-medium sm:px-6">© {new Date().getFullYear()} {store.name} Bangladesh. All rights reserved.</p>
  </div>
</footer>
