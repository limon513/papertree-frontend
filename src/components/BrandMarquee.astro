---
import type { Catalog } from '@/lib/types';
import { iconUrl, imageAt, links, srcSet } from '@/lib/utils';

/**
 * "Shop by brand": a row of brand tiles that moves slowly from left to right without end. It stops
 * while pointed at or tabbed into (so a brand can be picked), and stands still (swipeable) for people
 * whose phone or computer asks for less motion.
 *
 * How the endless loop works: the tiles are drawn twice in one long strip, which slides by exactly
 * half its width and starts again: the second copy then sits where the first was, so no jump shows.
 * Short brand lists are repeated first, so one copy is always wider than the screen.
 */
interface Props {
  brands: Catalog['brands'];
}
const { brands } = Astro.props;
const MIN_TILES = 14;
const set = Array.from({ length: Math.max(1, Math.ceil(MIN_TILES / brands.length)) }, () => brands).flat();
// About 3 seconds per tile: slow enough to read, quick enough to notice.
const seconds = set.length * 3;
---

<div class="marquee relative overflow-hidden py-1.5" style={`--marquee-time:${seconds}s`}>
  <ul class="marquee-track flex w-max">
    {
      [...set, ...set].map((b, i) => {
        // Only the first copy is read out and reached with Tab; the rest is the same tiles again.
        const copy = i >= brands.length;
        return (
          <li class="w-32 shrink-0 pr-3 sm:w-40" aria-hidden={copy ? 'true' : undefined}>
            <a
              href={links.brand(b.slug)}
              tabindex={copy ? -1 : undefined}
              class="flex h-24 flex-col items-center justify-center gap-1.5 rounded-2xl bg-white p-3 text-center ring-1 ring-zinc-200 transition hover:-translate-y-0.5 hover:shadow-md hover:shadow-zinc-900/5 hover:ring-lime-400"
            >
              {b.image ? (
                <img src={imageAt(b.image, 160)} srcset={srcSet(b.image)} sizes="140px" width={b.image.width} height={b.image.height} alt="" loading="lazy" class="h-10 w-auto max-w-full object-contain" />
              ) : b.icon ? (
                <img src={iconUrl(b.icon)} alt="" width="36" height="36" loading="lazy" class="size-9" />
              ) : null}
              <span class="line-clamp-1 text-xs font-semibold text-zinc-800 sm:text-sm">{b.name}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  /* Soft fade at both edges, so tiles glide in and out. */
  .marquee {
    mask-image: linear-gradient(to right, transparent, black 3rem, black calc(100% - 3rem), transparent);
  }
  .marquee-track {
    animation: marquee-right var(--marquee-time) linear infinite;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      mask-image: none;
      scrollbar-width: none;
    }
    .marquee-track {
      animation: none;
    }
  }
</style>
