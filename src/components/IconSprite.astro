---
/**
 * Small icons used many times on a page (the + and − on every product card), drawn once here and reused
 * with <svg><use href="#i-plus" /></svg>. Saves ~300 bytes per card.
 */
---

<svg aria-hidden="true" style="display:none">
  <symbol id="i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"></path></symbol>
  <symbol id="i-cart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></symbol>
  <!-- "Add to cart" on product cards, in colour: slate cart, yellow basket, green + badge. -->
  <symbol id="i-cart-add" viewBox="0 0 24 24">
    <path d="M5.2 6.6h14.3a.8.8 0 0 1 .78 1l-1.3 5.5a1.5 1.5 0 0 1-1.46 1.15H7.1z" fill="#facc15"></path>
    <path d="M1.8 2.8h2.4a.6.6 0 0 1 .58.47l2.6 12.1a1.6 1.6 0 0 0 1.57 1.26H19.5" fill="none" stroke="#475569" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="9.2" cy="20.2" r="1.7" fill="#475569"></circle>
    <circle cx="17.6" cy="20.2" r="1.7" fill="#475569"></circle>
    <circle cx="17.8" cy="6.4" r="5.2" fill="#22c55e" stroke="#fff" stroke-width="1.2"></circle>
    <path d="M17.8 4.1v4.6M15.5 6.4h4.6" stroke="#fff" stroke-width="1.8" stroke-linecap="round"></path>
  </symbol>
  <!-- The wishlist heart: outlined; filled when saved (fill set by the page's CSS). -->
  <symbol id="i-heart" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></symbol>
  <symbol id="i-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path></symbol>
</svg>
