---
import { ArrowRight, ChevronLeft, ChevronRight } from 'lucide-preact';
import type { ProductCard as Card } from '@/lib/types';
import ProductCard from './ProductCard.astro';

/** A titled row of products: swipe on phones, arrow buttons on computers. */
interface Props {
  title: string;
  href?: string;
  products: Card[];
  /** "deals" puts the row on a soft highlighter-yellow band. */
  tone?: 'plain' | 'deals';
  /** The first row on the page: its pictures load first. */
  priority?: boolean;
}
const { title, href, products, tone = 'plain', priority = false } = Astro.props;
---

{
  products.length > 0 && (
    <section class:list={['py-6 sm:py-8', tone === 'deals' && 'bg-marigold-50', !priority && 'later']}>
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mb-3 flex items-end justify-between gap-3 sm:mb-4">
          <h2 class="flex items-center gap-2 font-display text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl">
            <slot name="icon" />
            {title}
          </h2>
          {href && (
            <a href={href} class="flex shrink-0 items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800">
              See all <ArrowRight class="size-4" />
            </a>
          )}
        </div>
        <div class="rail relative">
          <ul class="scrollbar-none -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-1 sm:-mx-6 sm:scroll-px-6 sm:px-6 lg:mx-0 lg:px-0">
            {products.map((p, i) => (
              <li class="w-[44%] shrink-0 snap-start sm:w-[30%] md:w-[23%] lg:w-[calc((100%-5*0.75rem)/6)]">
                <ProductCard product={p} priority={priority && i < 2} />
              </li>
            ))}
          </ul>
          <button type="button" data-dir="-1" aria-label="Previous" class="rail-arrow absolute top-[38%] -left-4 hidden size-10 items-center justify-center rounded-full bg-white text-zinc-700 opacity-0 shadow-md ring-1 ring-zinc-200 transition hover:text-brand-700 lg:flex">
            <ChevronLeft class="size-5" />
          </button>
          <button type="button" data-dir="1" aria-label="Next" class="rail-arrow absolute top-[38%] -right-4 hidden size-10 items-center justify-center rounded-full bg-white text-zinc-700 opacity-0 shadow-md ring-1 ring-zinc-200 transition hover:text-brand-700 lg:flex">
            <ChevronRight class="size-5" />
          </button>
        </div>
      </div>
    </section>
  )
}

<script>
  // Arrow buttons for every row on the page (computers). Hidden at the ends of the row.
  for (const rail of document.querySelectorAll<HTMLElement>('.rail')) {
    const list = rail.querySelector('ul')!;
    const [prev, next] = rail.querySelectorAll<HTMLButtonElement>('.rail-arrow');
    const update = () => {
      const atStart = list.scrollLeft < 8;
      const atEnd = list.scrollLeft + list.clientWidth > list.scrollWidth - 8;
      prev!.classList.toggle('opacity-0', atStart);
      prev!.classList.toggle('pointer-events-none', atStart);
      next!.classList.toggle('opacity-0', atEnd);
      next!.classList.toggle('pointer-events-none', atEnd);
    };
    for (const button of [prev!, next!]) {
      button.addEventListener('click', () => list.scrollBy({ left: Number(button.dataset.dir) * list.clientWidth * 0.9, behavior: 'smooth' }));
    }
    list.addEventListener('scroll', update, { passive: true });
    // Rows further down are skipped by the browser until they come near the screen: check again then.
    rail.closest('section')?.addEventListener('contentvisibilityautostatechange', update);
    rail.addEventListener('pointerenter', update);
    addEventListener('resize', update);
    update();
  }
</script>
