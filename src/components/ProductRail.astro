---
import { ArrowRight, ChevronLeft, ChevronRight } from 'lucide-preact';
import type { ProductCard as Card } from '@/lib/types';
import ProductCard from './ProductCard.astro';

/** A titled row of products: swipe on phones, arrow buttons on computers. */
interface Props {
  title: string;
  href?: string;
  products: Card[];
  /** The row's own colour band, so each home section looks different: deals yellow, new arrivals lime. */
  tone?: 'plain' | 'deals' | 'new';
  /** A short line under the title. */
  subtitle?: string;
  /** Number the products (#1, #2…) on their pictures: best sellers. */
  ranked?: boolean;
  /** The first row on the page: its pictures load first. */
  priority?: boolean;
}
const { title, href, products, tone = 'plain', subtitle, ranked = false, priority = false } = Astro.props;
const band = { plain: null, deals: 'bg-marigold-50', new: 'bg-lime-50' }[tone];
---

{
  products.length > 0 && (
    <section class:list={['py-6 sm:py-8', band, !priority && 'later']}>
      <div class="mx-auto max-w-site px-4 sm:px-6">
        <div class="mb-3 flex items-end justify-between gap-3 sm:mb-4">
          <div class="flex min-w-0 items-center gap-3">
            <slot name="icon" />
            <div class="min-w-0">
              <h2 class="font-display text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl">{title}</h2>
              {subtitle && <p class="truncate text-sm text-zinc-600">{subtitle}</p>}
            </div>
          </div>
          {href && (
            <a href={href} class="flex shrink-0 items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800">
              See all <ArrowRight class="size-4" />
            </a>
          )}
        </div>
        <div class="rail relative">
          <ul class:list={['scrollbar-none -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-1 sm:-mx-6 sm:scroll-px-6 sm:px-6 lg:mx-0 lg:px-0', ranked && 'ranked']}>
            {products.map((p, i) => (
              <li class="rail-item">
                <ProductCard product={p} priority={priority && i < 2} />
              </li>
            ))}
          </ul>
          <button type="button" data-dir="-1" aria-label="Previous" class="rail-arrow absolute top-[38%] -left-4 hidden size-10 items-center justify-center rounded-full bg-white text-zinc-700 opacity-0 shadow-md ring-1 ring-zinc-200 transition hover:text-brand-700 lg:flex">
            <ChevronLeft class="size-5" />
          </button>
          <button type="button" data-dir="1" aria-label="Next" class="rail-arrow absolute top-[38%] -right-4 hidden size-10 items-center justify-center rounded-full bg-white text-zinc-700 opacity-0 shadow-md ring-1 ring-zinc-200 transition hover:text-brand-700 lg:flex">
            <ChevronRight class="size-5" />
          </button>
        </div>
      </div>
    </section>
  )
}

<script>
  import '@/scripts/rails';
</script>
