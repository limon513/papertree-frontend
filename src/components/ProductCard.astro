---
import type { ProductCard } from '@/lib/types';
import TagBadge from './TagBadge.astro';
import { Stars } from './Stars';
import { imageAt, links, money, percentOff, srcSet } from '@/lib/utils';

/**
 * A product in a list. Two actions: the cart icon (Add to cart) and Buy now (straight to checkout
 * with just this). Products with options open the "choose options" window instead. On computers,
 * moving the mouse across the picture shows the product's other pictures.
 * Plain HTML; src/scripts/product-cards.ts runs every card on the page.
 */
interface Props {
  product: ProductCard;
  /** Near the top of the page: load the picture first. */
  priority?: boolean;
}
const { product: p, priority = false } = Astro.props;
const off = percentOff(p.price, p.regularPrice);
// Only the small picture goes to the cart.
const thumb = p.image ? { urls: { '160': imageAt(p.image, 160) }, width: p.image.width, height: p.image.height, alt: null } : null;
// What the cart keeps for a product without options.
const item =
  p.variantId === null
    ? null
    : { variantId: p.variantId, productId: p.id, slug: p.slug, name: p.name, variantLabel: null, image: thumb, price: p.price, regularPrice: p.regularPrice, maxQuantity: p.lowStock };
// Pictures for picture-on-hover: one size each, loaded only when the card is pointed at.
const more = p.image && p.moreImages?.length ? [imageAt(p.image, 400), ...p.moreImages.map((m) => imageAt(m, 400))] : null;
const href = links.product(p.slug);
---

<div data-card={p.id} class="pc group">
  <a href={href} class="pc-pic" data-pics={more ? JSON.stringify(more) : undefined}>
    {
      p.image && (
        <img
          src={imageAt(p.image, 400)}
          srcset={srcSet(p.image)}
          sizes="(min-width: 1280px) 220px, (min-width: 640px) 30vw, 45vw"
          width={p.image.width}
          height={p.image.height}
          alt={p.image.alt ?? p.name}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          class:list={['pc-img', !more && 'pc-zoom', !p.inStock && 'opacity-50']}
        />
      )
    }
    {
      p.labels && p.labels.length > 0 && (
        <span class="absolute top-2 right-2 flex max-w-[70%] flex-col items-end gap-1">
          {p.labels.slice(0, 2).map((t) => (
            <TagBadge name={t.name} color={t.color} />
          ))}
        </span>
      )
    }
    {off >= 5 && <span data-off class="pc-off">−{off}%</span>}
    {
      more && (
        <span class="pc-bars" aria-hidden="true">
          {more.map((_, i) => (
            <i data-bar class:list={['pc-bar', i === 0 ? 'bg-brand-600' : 'bg-zinc-900/15']} />
          ))}
        </span>
      )
    }
  </a>
  <div class="pc-body">
    <span class="pc-brand">{p.brand?.name}</span>
    <a href={href} class="pc-name">{p.name}</a>
    {
      p.rating ? (
        <span class="mt-1 flex items-center gap-1 text-xs text-zinc-500">
          <Stars value={p.rating.average} size="size-3.5" />
          <span class="tabular-nums">{p.rating.average.toFixed(1)} ({p.rating.count})</span>
        </span>
      ) : null
    }
    <div class="pc-prices">
      {p.variantCount > 1 && <span class="text-xs text-zinc-500">from</span>}
      <span data-price class="pc-price">{money(p.price)}</span>
      <span data-was hidden={off <= 0} class="pc-was">{off > 0 ? money(p.regularPrice!) : ''}</span>
      <span data-ws hidden class="pc-ws">Wholesale</span>
    </div>
    <span class="pc-note">{p.lowStock ? `Only ${p.lowStock} left` : p.variantCount > 1 ? `${p.variantCount} options` : ''}</span>
    {
      !p.inStock ? (
        <span class="pc-out">Out of stock</span>
      ) : (
        <div
          class="pc-actions"
          data-item={item ? JSON.stringify(item) : undefined}
          data-quick={item ? undefined : p.slug}
          data-product={p.id}
          data-href={href}
        >
          <button
            type="button"
            data-act="add"
            aria-label={`Add ${p.name} to cart`}
            class="pc-add"
          >
            <svg class="size-5"><use href="#i-cart-plus" /></svg>
            <span data-qty hidden class="pc-qty">0</span>
          </button>
          <button type="button" data-act="buy" class="pc-buy">
            Buy now
          </button>
        </div>
      )
    }
  </div>
</div>

<script>
  import '@/scripts/product-cards';
</script>
