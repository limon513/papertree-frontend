# The PaperTree API, as the website server reaches it (read when the site runs).
API_URL=http://localhost:4000
# The API as browsers reach it (search as you type, cart). Built into the page code: set before "npm run build".
PUBLIC_API_URL=http://localhost:4000
# This website's own address, for links shared on Facebook and Google. Set before "npm run build".
PUBLIC_SITE_URL=http://localhost:3000
